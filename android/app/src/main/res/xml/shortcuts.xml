            android:data="iremote://control?device=fan&amp;action=toggle" />
    </shortcut>
    <shortcut
        android:shortcutId="toggle_fireplace"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_fireplace_short"
