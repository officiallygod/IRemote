    </shortcut>
    <shortcut
        android:shortcutId="scene_sleep"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_sleep_short"
        android:shortcutLongLabel="@string/shortcut_sleep_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.iremote.app"
            android:targetClass="com.iremote.app.MainActivity"
            android:data="iremote://scene?name=sleep" />
    </shortcut>
</shortcuts>
